# ===================================================================
# Enterprise Field Visit & CRM System - Environment Variables
# Copy this file to .env before starting: cp .env.example .env
# ===================================================================

# Web Application Ports
FRONTEND_PORT=80
BACKEND_PORT=4000

# Microsoft SQL Server Configuration
DB_PORT=1433
DB_NAME=field_visit
DB_USER=sa
# IMPORTANT: Provide a strong SA password meeting MSSQL complexity requirements
# (at least 8 characters with uppercase, lowercase, numbers, and symbols)
DB_PASSWORD=FieldCRM@Secure2026!
MSSQL_PID=Developer

# Security & JWT Token Authentication
# Change this secret key in production!
JWT_SECRET=EnterpriseFieldVisitCRMSecureProductionKey2026EnterpriseFieldVisitCRMSecretKey2026!
JWT_EXPIRATION_MS=86400000

# Database Schema Synchronization (update | validate | none)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JVM Memory and Garbage Collection Flags
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
